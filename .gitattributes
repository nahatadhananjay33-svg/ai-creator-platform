# Normalize line endings across platforms (Windows dev <-> Colab / Linux GPU).
# Text files are stored as LF in the repo and checked out as LF everywhere.
* text=auto eol=lf

# Shell scripts must stay LF.
*.sh text eol=lf

# Windows batch/PowerShell keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.flac binary
*.mp4  binary
*.avi  binary
*.mov  binary
*.ckpt binary
*.safetensors binary
*.pt   binary
*.pth  binary
*.onnx binary
*.bin  binary
